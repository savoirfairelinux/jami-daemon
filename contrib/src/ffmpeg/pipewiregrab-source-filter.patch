+/** Maximum number of modifiers collected from a single DRM plane format */
+#define MAX_DRM_MODIFIERS 64
+
+/**
+ * DRM format+modifier pairs discovered by scanning a device's planes.
+ * Only formats that overlap with pipewiregrab_formats are retained.
+ */
+typedef struct DRMFormatModifiers {
+    uint32_t drm_format; /**< DRM_FORMAT_* fourcc */
+    uint64_t modifiers[MAX_DRM_MODIFIERS];
+    int n_modifiers;
+} DRMFormatModifiers;
+
+#define MAX_DRM_FORMATS 32
+
+/**
+ * Result of scanning a DRM device node for plane capabilities.
+ */
+typedef struct DRMDeviceInfo {
+    char device_path[256];
+    DRMFormatModifiers formats[MAX_DRM_FORMATS];
+    int n_formats;
+} DRMDeviceInfo;
