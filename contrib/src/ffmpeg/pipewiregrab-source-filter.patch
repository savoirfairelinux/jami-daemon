+    int64_t time_frame;
+    int64_t frame_duration;
+    AVRational framerate;
+    pthread_mutex_t current_frame_mutex;
+    AVFrame *current_frame;
+    AVBufferRef *hw_device_ref;
+    AVBufferRef *hw_frames_ref;
+    int enable_dmabuf;
+    const char *device_path;
+
+    /** DRM device capabilities discovered during init (formats + modifiers) */
+    DRMDeviceInfo drm_device_info;
+
+    int portal_error;
+    int pipewire_error;
+} PipewireGrabContext;
