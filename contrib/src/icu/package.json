{
    "name": "icu",
    "version": "78.3",
    "cpe": "cpe:2.3:a:unicode:icu:78.3:*:*:*:*:*:*:*",
    "url": "https://github.com/unicode-org/icu/releases/download/release-__VERSION__/icu4c-__VERSION__-Win64-MSVC2022.zip",
    "deps": [],
    "defines": [],
    "patches": [],
    "win_patches": [],
    "project_paths": [],
    "with_env": "",
    "custom_scripts": {
        "pre_build": [],
        "build": [],
        "post_build": [
            "if not exist \"%DAEMON_DIR%\\contrib\\x64-windows\\include\" mkdir \"%DAEMON_DIR%\\contrib\\x64-windows\\include\"",
            "if not exist \"%DAEMON_DIR%\\contrib\\x64-windows\\lib\" mkdir \"%DAEMON_DIR%\\contrib\\x64-windows\\lib\"",
            "if not exist \"%DAEMON_DIR%\\contrib\\x64-windows\\bin\" mkdir \"%DAEMON_DIR%\\contrib\\x64-windows\\bin\"",
            "xcopy /S /Y /I \"include\" \"%DAEMON_DIR%\\contrib\\x64-windows\\include\"",
            "xcopy /Y \"lib64\\*.lib\" \"%DAEMON_DIR%\\contrib\\x64-windows\\lib\\\"",
            "xcopy /Y \"bin64\\*.dll\" \"%DAEMON_DIR%\\contrib\\x64-windows\\bin\\\""
        ]
    }
}
